{
  "info": {
    "name": "DIPROPERTI API - Mutation Dummy",
    "_postman_id": "diproperti-api-mutation-dummy",
    "description": "Collection endpoint mutasi data Laravel DIPROPERTI. Jalankan hanya pada database lokal/staging dengan data dummy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{admin_token}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('status 2xx/4xx valid', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 409, 422]);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Profile",
      "item": [
        {
          "name": "PATCH /user/profile",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/user/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Postman\",\n  \"phone\": \"081234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "POST /user/profile",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/user/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Postman\",\n  \"phone\": \"081234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        }
      ]
    },
    {
      "name": "Admin Tags Dummy CRUD",
      "item": [
        {
          "name": "POST /admin/tags",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/tags",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Dummy {{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('test_tag_id', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /admin/tags/{tag}",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/admin/tags/{{test_tag_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Dummy Updated {{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }]
          }
        },
        {
          "name": "DELETE /admin/tags/{tag}",
          "request": { "method": "DELETE", "url": "{{base_url}}/admin/tags/{{test_tag_id}}" }
        }
      ]
    },
