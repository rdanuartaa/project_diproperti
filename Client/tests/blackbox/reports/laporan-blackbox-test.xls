   </Row>
   <Row><Cell><Data ss:Type="String">A-001</Data></Cell><Cell><Data ss:Type="String">Proteksi Admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Akses admin belum login</Data></Cell><Cell><Data ss:Type="String">User belum login</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka /admin/add-properti dan /admin/pengajuan-properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User tidak dapat mengakses data admin dan diarahkan ke login</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-002</Data></Cell><Cell><Data ss:Type="String">Dasboard</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Menampilkan statistik</Data></Cell><Cell><Data ss:Type="String">Admin login</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Login admin lalu buka /admin/dashboard</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Kartu statistik dan chart tampil sesuai data backend</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-003</Data></Cell><Cell><Data ss:Type="String">Kelola User</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List dan pagination user</Data></Cell><Cell><Data ss:Type="String">Data user &gt; 10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Kelola User dan klik pagination</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel menampilkan maksimal 10 data per halaman, panah aktif sesuai halaman</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin dan dataset cukup</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-004</Data></Cell><Cell><Data ss:Type="String">Kelola User</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Ubah role/status user</Data></Cell><Cell><Data ss:Type="String">User non-admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Edit user, ubah field yang tersedia, simpan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data user berubah dan pesan sukses muncul</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-005</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List properti admin</Data></Cell><Cell><Data ss:Type="String">Semua status properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel admin menampilkan properti termasuk sold/terjual untuk tracking penjualan</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-006</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah properti</Data></Cell><Cell><Data ss:Type="String">Data properti valid dan gambar</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik tambah, isi informasi dasar, lokasi detail, fasilitas, upload gambar, simpan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Properti baru tersimpan dan tampil di tabel</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-007</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Validasi tambah properti</Data></Cell><Cell><Data ss:Type="String">Field wajib kosong</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka modal tambah lalu simpan tanpa mengisi field wajib</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Sistem menampilkan pesan validasi dan data tidak tersimpan</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-008</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Edit properti</Data></Cell><Cell><Data ss:Type="String">Properti existing</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik edit, ubah harga/status/deskripsi, simpan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Perubahan tersimpan, status Ditampilkan/Pending/Terjual sesuai pilihan</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-009</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Hapus properti</Data></Cell><Cell><Data ss:Type="String">Properti existing</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik hapus, batalkan, lalu ulangi dan konfirmasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Batal tidak menghapus data; konfirmasi menghapus data dan tabel diperbarui</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-010</Data></Cell><Cell><Data ss:Type="String">Kelola Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pagination properti admin</Data></Cell><Cell><Data ss:Type="String">Data &gt; 10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik halaman 2 dan panah pagination</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel berpindah halaman, tracking "Menampilkan x-y of z hasil" sesuai data</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin dan dataset cukup</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-011</Data></Cell><Cell><Data ss:Type="String">Pengajuan Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List pengajuan</Data></Cell><Cell><Data ss:Type="String">Pengajuan pending</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka menu Pengajuan Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel menampilkan pengajuan user beserta status dan aksi detail</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin dan data pengajuan</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-012</Data></Cell><Cell><Data ss:Type="String">Pengajuan Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Detail dan approve pengajuan</Data></Cell><Cell><Data ss:Type="String">Pengajuan pending valid</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka detail, cek dokumen, klik setujui</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengajuan berubah menjadi properti ditampilkan dan muncul di Kelola Properti</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-013</Data></Cell><Cell><Data ss:Type="String">Pengajuan Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tolak/hapus pengajuan</Data></Cell><Cell><Data ss:Type="String">Pengajuan tidak valid</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik hapus/tolak dan konfirmasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengajuan tidak lagi tampil di tabel setelah konfirmasi</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-014</Data></Cell><Cell><Data ss:Type="String">Kelola Artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah artikel</Data></Cell><Cell><Data ss:Type="String">Judul, konten, tag, gambar</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Kelola Artikel, klik tambah, isi form, upload gambar, simpan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Artikel tersimpan dan muncul di tabel/list artikel jika status publish</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-015</Data></Cell><Cell><Data ss:Type="String">Kelola Artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Edit dan hapus artikel</Data></Cell><Cell><Data ss:Type="String">Artikel existing</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Edit artikel, simpan, lalu uji hapus dengan konfirmasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Edit tersimpan; hapus menghilangkan artikel dari tabel</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-016</Data></Cell><Cell><Data ss:Type="String">Kelola Tag</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">CRUD tag artikel</Data></Cell><Cell><Data ss:Type="String">Nama tag unik</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah tag, edit nama/status, hapus tag</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tag tersimpan, berubah, dan terhapus sesuai aksi; validasi tampil untuk data tidak valid</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-017</Data></Cell><Cell><Data ss:Type="String">Kelola FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">CRUD FAQ</Data></Cell><Cell><Data ss:Type="String">Pertanyaan dan jawaban</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah FAQ, edit isi, hapus FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">FAQ tersimpan, berubah, dan terhapus; FAQ aktif tampil di halaman publik FAQ</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-018</Data></Cell><Cell><Data ss:Type="String">Semua Tabel Admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Search dan filter tabel</Data></Cell><Cell><Data ss:Type="String">Keyword valid/tidak valid</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Masukkan keyword pencarian dan pilih filter status/tipe bila tersedia</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel hanya menampilkan data yang sesuai; kondisi kosong menampilkan empty state yang jelas</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-019</Data></Cell><Cell><Data ss:Type="String">Semua Tabel Admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pagination tabel admin</Data></Cell><Cell><Data ss:Type="String">Data &gt; 10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Cek halaman awal, klik panah/angka, cek tracking hasil</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Maksimal 10 data per halaman; halaman aktif primary; panah hover primary dengan icon putih; tracking sesuai data</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin dan dataset cukup</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">A-020</Data></Cell><Cell><Data ss:Type="String">Logout</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Konfirmasi logout</Data></Cell><Cell><Data ss:Type="String">Admin login</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik Logout, pilih Batal, lalu ulangi dan pilih Logout</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Batal menutup modal; konfirmasi mengakhiri sesi dan mengarahkan keluar admin</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin</Data></Cell></Row>
  </Table>
 </Worksheet>

