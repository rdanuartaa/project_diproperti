<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
 <Styles>
  <Style ss:ID="Title"><Font ss:Bold="1" ss:Size="16"/><Interior ss:Color="#D9EAFD" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Header"><Font ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0050A8" ss:Pattern="Solid"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/></Borders></Style>
  <Style ss:ID="OK"><Font ss:Bold="1" ss:Color="#087F5B"/><Interior ss:Color="#DFF6E8" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Ready"><Font ss:Bold="1" ss:Color="#8A5A00"/><Interior ss:Color="#FFF3CD" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Blocked"><Font ss:Bold="1" ss:Color="#B42318"/><Interior ss:Color="#FEE4E2" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Note"><Alignment ss:WrapText="1" ss:Vertical="Top"/></Style>
  <Style ss:ID="Wrap"><Alignment ss:WrapText="1" ss:Vertical="Top"/></Style>
 </Styles>

 <Worksheet ss:Name="Ringkasan">
  <Table>
   <Column ss:Width="220"/><Column ss:Width="520"/>
   <Row><Cell ss:MergeAcross="1" ss:StyleID="Title"><Data ss:Type="String">Laporan Pengujian Blackbox DIPROPERTI</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Tanggal</Data></Cell><Cell><Data ss:Type="String">21 Mei 2026</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Metode</Data></Cell><Cell><Data ss:Type="String">Blackbox testing berdasarkan menu dan fitur yang terlihat oleh pengguna</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Lingkup Main</Data></Cell><Cell><Data ss:Type="String">Beranda, Properti, Detail Properti, Rekomendasi, Komparasi, Simulasi KPR, Artikel, FAQ, Kontak, Jual Properti</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Lingkup Admin</Data></Cell><Cell><Data ss:Type="String">Dasboard, Kelola User, Kelola Properti, Pengajuan Properti, Kelola Artikel, Kelola Tag, Kelola FAQ, Logout</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Status Terverifikasi Otomatis</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">Menu publik utama dan akses detail properti lolos Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Status Admin Menu</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">Semua menu admin berhasil diakses otomatis memakai token admin test dari database lokal</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Status Admin CRUD</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Skenario tambah, edit, hapus, dan approve data siap diuji dengan data dummy terkontrol</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Catatan</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Pengujian blackbox tidak melihat kode internal. Admin yang membutuhkan autentikasi diverifikasi sampai redirect login pada kondisi belum login; CRUD admin perlu dijalankan dengan akun admin agar hasilnya valid.</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Main">
  <Table>
   <Column ss:Width="70"/><Column ss:Width="150"/><Column ss:Width="250"/><Column ss:Width="230"/><Column ss:Width="360"/><Column ss:Width="330"/><Column ss:Width="110"/><Column ss:Width="280"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Menu</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Skenario</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Data Uji</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Langkah Uji</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Hasil yang Diharapkan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">M-001</Data></Cell><Cell><Data ss:Type="String">Beranda</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka halaman utama</Data></Cell><Cell><Data ss:Type="String">/</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka aplikasi dari URL utama</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman beranda tampil tanpa 404 dan memuat konten properti</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-002</Data></Cell><Cell><Data ss:Type="String">Beranda</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tab kategori properti</Data></Cell><Cell><Data ss:Type="String">Rumah, Villa, Ruko, Kos, Tanah</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik setiap tab kategori di bagian properti beranda</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tab aktif berpindah sesuai kategori yang dipilih</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-003</Data></Cell><Cell><Data ss:Type="String">Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka daftar properti</Data></Cell><Cell><Data ss:Type="String">/list-properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Daftar properti, filter utama, dan pagination tampil</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-004</Data></Cell><Cell><Data ss:Type="String">Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Filter tipe dan status penawaran</Data></Cell><Cell><Data ss:Type="String">rumah, Dijual/Disewa</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pilih tipe properti dan status penawaran, lalu terapkan filter</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List hanya menampilkan properti yang sesuai filter dan jumlah hasil berubah</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Uji manual disarankan dengan data beragam</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-005</Data></Cell><Cell><Data ss:Type="String">Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pagination daftar properti</Data></Cell><Cell><Data ss:Type="String">Data &gt; 10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik angka halaman dan tombol panah pagination</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Maksimal 10 properti per halaman; properti ke-11 tampil di halaman berikutnya; tracking jumlah data sesuai meta backend</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh dataset lebih dari 10 properti publik</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-006</Data></Cell><Cell><Data ss:Type="String">Detail Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka detail dari list</Data></Cell><Cell><Data ss:Type="String">Slug properti publik</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik tombol Detail pada salah satu card properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman detail terbuka, tidak 404, dan menampilkan informasi properti</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-007</Data></Cell><Cell><Data ss:Type="String">Detail Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah properti ke komparasi dari detail</Data></Cell><Cell><Data ss:Type="String">Properti aktif</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik tombol compare pada detail properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Compare bar muncul, properti masuk ke compare bar, dan user diarahkan ke daftar properti untuk mencari pembanding</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Uji manual interaksi compare</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-008</Data></Cell><Cell><Data ss:Type="String">Komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka halaman komparasi</Data></Cell><Cell><Data ss:Type="String">/komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Fitur lalu Komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman komparasi tampil tanpa error</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-009</Data></Cell><Cell><Data ss:Type="String">Komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membandingkan 2-3 properti</Data></Cell><Cell><Data ss:Type="String">2 atau 3 properti sejenis</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambahkan beberapa properti ke compare bar lalu buka halaman komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel perbandingan, skor, kelebihan, kekurangan, dan rekomendasi tampil sesuai pilihan</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh data pembanding</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-010</Data></Cell><Cell><Data ss:Type="String">Rekomendasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka rekomendasi properti</Data></Cell><Cell><Data ss:Type="String">/rekomendasi-properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Fitur lalu Rekomendasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman rekomendasi tampil dan kriteria dapat diatur</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-011</Data></Cell><Cell><Data ss:Type="String">Rekomendasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Bobot kriteria dan pagination rekomendasi</Data></Cell><Cell><Data ss:Type="String">Harga, lokasi, luas, fasilitas</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Ubah slider kriteria lalu cek hasil dan pagination</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Properti direkomendasikan berurutan berdasarkan skor; maksimal 10 item per halaman</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Uji manual dengan beberapa data properti</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-012</Data></Cell><Cell><Data ss:Type="String">Simulasi KPR</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka simulasi KPR</Data></Cell><Cell><Data ss:Type="String">/simulasi-kpr</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Fitur lalu Simulasi KPR</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman kalkulator KPR tampil</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-013</Data></Cell><Cell><Data ss:Type="String">Simulasi KPR</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Menghitung cicilan</Data></Cell><Cell><Data ss:Type="String">Harga, DP, tenor, bunga</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Isi form simulasi lalu jalankan perhitungan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Estimasi cicilan tampil dan berubah sesuai input</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Uji validasi angka dan nilai kosong</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-014</Data></Cell><Cell><Data ss:Type="String">Artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka list artikel</Data></Cell><Cell><Data ss:Type="String">/list-artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Daftar artikel tampil tanpa error</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-015</Data></Cell><Cell><Data ss:Type="String">Artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pagination artikel</Data></Cell><Cell><Data ss:Type="String">Data &gt; 5</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik pagination pada daftar artikel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Artikel ditampilkan maksimal 5 per halaman dan halaman berikutnya memuat sisa data</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh dataset artikel lebih dari 5</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-016</Data></Cell><Cell><Data ss:Type="String">FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka FAQ</Data></Cell><Cell><Data ss:Type="String">/faq</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu FAQ dari footer atau akses URL</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">FAQ tampil dan accordion dapat dibuka/tutup</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-017</Data></Cell><Cell><Data ss:Type="String">Kontak</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Membuka halaman kontak</Data></Cell><Cell><Data ss:Type="String">/contact</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Akses halaman kontak</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Informasi kontak tampil tanpa error</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-018</Data></Cell><Cell><Data ss:Type="String">Jual Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Akses jual properti belum login</Data></Cell><Cell><Data ss:Type="String">User belum login</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik menu Jual Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User diarahkan ke state login atau form sesuai autentikasi</Data></Cell><Cell ss:StyleID="OK"><Data ss:Type="String">OK</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium smoke test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-019</Data></Cell><Cell><Data ss:Type="String">Jual Properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Submit pengajuan properti</Data></Cell><Cell><Data ss:Type="String">User login dan data valid</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Isi form jual properti, pilih lokasi, upload dokumen, lalu submit</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengajuan tersimpan dengan status pending dan tampil di admin Pengajuan Properti</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Butuh login user</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">M-020</Data></Cell><Cell><Data ss:Type="String">Responsif Mobile</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Menu mobile dan layout card</Data></Cell><Cell><Data ss:Type="String">Viewport mobile</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka menu mobile dan halaman fitur utama</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Menu aktif sesuai halaman; card tidak overlap; gambar dan teks tersusun rapi</Data></Cell><Cell ss:StyleID="Ready"><Data ss:Type="String">Siap Diuji</Data></Cell><Cell><Data ss:Type="String">Uji manual visual mobile</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Admin">
  <Table>
   <Column ss:Width="70"/><Column ss:Width="170"/><Column ss:Width="260"/><Column ss:Width="230"/><Column ss:Width="380"/><Column ss:Width="350"/><Column ss:Width="110"/><Column ss:Width="280"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Menu</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Skenario</Data></Cell>
