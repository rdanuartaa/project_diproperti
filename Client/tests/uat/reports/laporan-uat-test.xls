<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
 <Styles>
  <Style ss:ID="Title"><Font ss:Bold="1" ss:Size="16"/><Interior ss:Color="#D9EAFD" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Header"><Font ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0050A8" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Accepted"><Font ss:Bold="1" ss:Color="#087F5B"/><Interior ss:Color="#DFF6E8" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Pending"><Font ss:Bold="1" ss:Color="#8A5A00"/><Interior ss:Color="#FFF3CD" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Rejected"><Font ss:Bold="1" ss:Color="#B42318"/><Interior ss:Color="#FEE4E2" ss:Pattern="Solid"/></Style>
  <Style ss:ID="Wrap"><Alignment ss:WrapText="1" ss:Vertical="Top"/></Style>
  <Style ss:ID="Note"><Alignment ss:WrapText="1" ss:Vertical="Top"/></Style>
 </Styles>

 <Worksheet ss:Name="Ringkasan">
  <Table>
   <Column ss:Width="230"/><Column ss:Width="560"/>
   <Row><Cell ss:MergeAcross="1" ss:StyleID="Title"><Data ss:Type="String">Laporan User Acceptance Testing DIPROPERTI</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Tanggal</Data></Cell><Cell><Data ss:Type="String">21 Mei 2026</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Metode</Data></Cell><Cell><Data ss:Type="String">User Acceptance Testing berdasarkan kebutuhan pengguna dan role aplikasi</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Role UAT</Data></Cell><Cell><Data ss:Type="String">Pengunjung, User Penjual Properti, Admin</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Sumber Status Diterima</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Status Diterima diberikan untuk alur yang sudah terbukti melalui Selenium test dan blackbox admin menu test.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Catatan</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">UAT alur yang mengubah data seperti submit pengajuan, approve pengajuan, tambah, edit, dan hapus data admin perlu dijalankan memakai data dummy terkontrol agar tidak mengganggu data utama.</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Pengunjung">
  <Table>
   <Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="300"/><Column ss:Width="380"/><Column ss:Width="360"/><Column ss:Width="120"/><Column ss:Width="280"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kebutuhan Pengguna</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kriteria Penerimaan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Langkah UAT</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Hasil yang Diharapkan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-001</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat memahami layanan utama dari beranda</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Beranda tampil jelas, tidak error, dan menampilkan konten properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka halaman utama aplikasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Beranda tampil tanpa 404 dan konten utama terlihat</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-002</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat melihat properti berdasarkan kategori</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tab Rumah, Villa, Ruko, Kos, Tanah dapat dipilih</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik semua tab kategori di beranda</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Kategori aktif berpindah sesuai pilihan pengguna</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-003</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat mencari properti dari daftar properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman list properti tampil dengan filter dan data properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka menu Properti, gunakan filter tipe/status/lokasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Daftar properti menyesuaikan filter dan tidak menampilkan properti terjual</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Route dan reset filter sudah terverifikasi; kombinasi filter perlu divalidasi pengguna</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-004</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat membuka detail properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Detail properti terbuka dari card/list properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik tombol Detail pada salah satu properti publik</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman detail tampil tanpa 404 dan informasi properti terlihat</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-005</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat membandingkan properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Properti bisa masuk compare bar dan halaman komparasi bisa dibuka</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambahkan 2 properti ke komparasi lalu buka halaman Komparasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Perbandingan properti tampil dengan skor, kelebihan, kekurangan, dan rekomendasi</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Halaman komparasi sudah terverifikasi; isi perbandingan perlu dicek dengan data pilihan user</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-006</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat menggunakan rekomendasi properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Bobot kriteria dapat diatur dan hasil rekomendasi tampil</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Rekomendasi, atur kriteria, lihat hasil rekomendasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Properti tampil berdasarkan kecocokan preferensi dan pagination bekerja</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Route sudah terverifikasi; penilaian rekomendasi perlu disetujui pengguna</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-007</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat menghitung simulasi KPR</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Input harga, DP, bunga, tenor menghasilkan estimasi cicilan</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Isi kalkulator KPR dengan data contoh dan cek hasil</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Estimasi cicilan tampil dan berubah sesuai input</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Route sudah terverifikasi; akurasi rumus perlu validasi acceptance</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-008</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat membaca artikel dan FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">List artikel dan FAQ tampil tanpa error</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka menu Artikel dan FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Konten artikel dan FAQ dapat dibaca</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-PG-009</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengunjung dapat menghubungi admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman kontak dan tombol WhatsApp dapat diakses</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka halaman Kontak dan footer</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Informasi kontak tampil dan link kontak tersedia</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Route terverifikasi Selenium test</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="User Penjual">
  <Table>
   <Column ss:Width="80"/><Column ss:Width="240"/><Column ss:Width="300"/><Column ss:Width="380"/><Column ss:Width="360"/><Column ss:Width="130"/><Column ss:Width="280"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kebutuhan Pengguna</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kriteria Penerimaan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Langkah UAT</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Hasil yang Diharapkan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">UAT-US-001</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User belum login diarahkan ke autentikasi saat menjual properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Akses Jual Properti tidak membuka form tanpa autentikasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka menu Jual Properti saat belum login</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Halaman menampilkan state login atau redirect autentikasi</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Terverifikasi Selenium test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-US-002</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User dapat mengajukan properti untuk dijual</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Form menerima data valid, gambar, dokumen, dan lokasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Login sebagai user, isi form Jual Properti, pilih lokasi, upload dokumen, submit</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengajuan tersimpan dengan status pending dan menunggu admin</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Butuh akun user dan data dummy pengajuan</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-US-003</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User mendapat validasi saat data pengajuan belum lengkap</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Sistem menolak submit jika field wajib kosong</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Kosongkan field wajib lalu submit form</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pesan validasi tampil dan pengajuan tidak tersimpan</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Butuh sesi user</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-US-004</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">User dapat memakai location picker secara akurat</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Koordinat, alamat lengkap, kota, dan kecamatan terisi sesuai lokasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Geser pin lokasi di area Jember dan luar Jember</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Alamat lengkap, kota, kecamatan, latitude, dan longitude terisi otomatis</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi User</Data></Cell><Cell><Data ss:Type="String">Perlu sampling beberapa titik lokasi</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Admin">
  <Table>
   <Column ss:Width="80"/><Column ss:Width="240"/><Column ss:Width="300"/><Column ss:Width="380"/><Column ss:Width="360"/><Column ss:Width="130"/><Column ss:Width="300"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">ID</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kebutuhan Admin</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Kriteria Penerimaan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Langkah UAT</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Hasil yang Diharapkan</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Keterangan</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-001</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mengakses seluruh menu admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Dasboard, Kelola User, Kelola Properti, Pengajuan Properti, Kelola Artikel, Kelola Tag, Kelola FAQ dapat dibuka</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Login admin dan buka semua menu admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Semua menu terbuka tanpa 404, tanpa unauthorized, dan label menu tampil</Data></Cell><Cell ss:StyleID="Accepted"><Data ss:Type="String">Diterima</Data></Cell><Cell><Data ss:Type="String">Terverifikasi blackbox Selenium token admin test</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-002</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat melihat ringkasan dasboard</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Statistik dan grafik tampil sesuai data backend</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Dasboard admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Statistik properti, user, artikel, dan grafik analitik tampil</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Halaman bisa dibuka; angka perlu disetujui admin berdasarkan data aktual</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-003</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mengelola user</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mencari, memfilter, mengubah role, dan menghapus user non-admin</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Kelola User, gunakan search/filter, edit role user test, hapus user test</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data user berubah sesuai aksi dan pesan sukses tampil</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh data user dummy terkontrol</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-004</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mengelola properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat tambah, edit, ubah status, hapus, dan melihat properti terjual</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Kelola Properti, tambah properti dummy, edit status, hapus data dummy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Properti tersimpan, berubah, terhapus sesuai aksi; status Ditampilkan/Pending/Terjual sesuai pilihan</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh data properti dummy</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-005</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat memproses pengajuan properti</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat melihat detail dokumen dan menyetujui pengajuan valid</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka Pengajuan Properti, lihat detail pengajuan dummy, approve</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Pengajuan berubah menjadi properti ditampilkan dan muncul di Kelola Properti</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh pengajuan dummy dari user</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-006</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mengelola artikel dan tag</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Artikel dan tag dapat dibuat, diedit, dipublish, dan dihapus</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah artikel/tag dummy, edit, lalu hapus</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data artikel/tag berubah sesuai aksi dan artikel publish tampil di halaman publik</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh data dummy artikel/tag</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-007</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat mengelola FAQ</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">FAQ dapat dibuat, diedit, dipublish, dan dihapus</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tambah FAQ dummy, cek di halaman publik, edit, lalu hapus</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">FAQ aktif tampil di halaman publik dan berubah sesuai aksi admin</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh data dummy FAQ</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-008</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat menggunakan pagination semua tabel</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tabel menampilkan maksimal 10 data per halaman dan tracking jumlah data benar</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Buka tabel admin yang datanya lebih dari 10, klik halaman berikutnya</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Data halaman berubah, panah aktif sesuai kondisi, dan tracking menampilkan range data yang benar</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh dataset lebih dari 10 per tabel</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">UAT-AD-009</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Admin dapat logout dengan konfirmasi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Batal tidak logout, konfirmasi mengakhiri sesi</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Klik Logout, pilih Batal, lalu ulangi dan pilih Logout</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Modal bekerja sesuai pilihan dan sesi admin berakhir saat dikonfirmasi</Data></Cell><Cell ss:StyleID="Pending"><Data ss:Type="String">Perlu Validasi Admin</Data></Cell><Cell><Data ss:Type="String">Butuh sesi admin UI penuh</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Kesimpulan">
  <Table>
   <Column ss:Width="240"/><Column ss:Width="620"/>
   <Row><Cell ss:StyleID="Header"><Data ss:Type="String">Bagian</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Kesimpulan</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Fitur Publik</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Sebagian besar fitur publik inti diterima karena sudah terbukti dapat diakses dan tidak error pada Selenium test. Validasi preferensi seperti rekomendasi dan kalkulator KPR tetap perlu acceptance dari pengguna.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Fitur Admin</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Akses semua menu admin diterima. CRUD admin perlu dieksekusi dengan data dummy agar hasil penerimaan tidak merusak data aktual.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Tahap Berikutnya</Data></Cell><Cell ss:StyleID="Note"><Data ss:Type="String">Setelah UAT skenario data dummy selesai, lanjutkan pengujian API menggunakan Postman untuk endpoint public, auth, admin, property, article, tag, FAQ, dan upload/download dokumen.</Data></Cell></Row>
  </Table>
 </Worksheet>
</Workbook>
